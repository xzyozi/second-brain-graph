{
  "api_base": "http://localhost:8080/v1",
  "default_provider": "openai",
  "models": {
    "planner": {
      "description": "汎用・設計・計画用モデル (gemma4-12b-it-Q4_K_M:latest)",
      "temperature": 0.2,
      "max_tokens": 35000
    },
    "coder": {
      "description": "Python・コード記述特化モデル (gemma-4-py_coder:latest)",
      "temperature": 0.1,
      "max_tokens": 35000
    },
    "reviewer": {
      "description": "汎用・コード監査・レビュー用モデル (gemma4-12b-it-Q4_K_M:latest)",
      "temperature": 0.1,
      "max_tokens": 35000
    }
  },
  "aider": {
    "description": "Aider 自動コード編集用モデル (gemma-4-py_coder:latest)",
    "no_auto_commits": true,
    "edit_format": "diff"
  },
  "backend_execution": {
    "mode": "exclusive",
    "fallback": "disabled",
    "routes": {
      "spec_draft": "reasoning_economy",
      "task_decomposition": "reasoning_economy",
      "task_prioritization": "reasoning_economy",
      "code_edit": "coding_ollama",
      "aider_edit": "coding_ollama",
      "code_review": "coding_ollama"
    },
    "profiles": {
      "reasoning_economy": {
        "backend": "llama_server",
        "model": "gemma-4-12B-it-qat-UD-Q4_K_XL",
        "endpoint": "http://localhost:8080/v1",
        "port": 8080,
        "model_path": "./models/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
      },
      "coding_ollama": {
        "backend": "ollama",
        "model": "gemma-4-py_coder:latest",
        "endpoint": "http://localhost:11434"
      }
    }
  }
}
