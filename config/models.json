{
  "models": {
    "planner": {
      "description": "汎用・設計・計画用モデル",
      "temperature": 0.2,
      "max_tokens": 35000
    },
    "coder": {
      "description": "Python・コード記述特化モデル",
      "temperature": 0.1,
      "max_tokens": 35000
    },
    "reviewer": {
      "description": "汎用・コード監査・レビュー用モデル",
      "temperature": 0.1,
      "max_tokens": 35000
    }
  },
  "aider": {
    "description": "Aider 自動コード編集用モデル",
    "no_auto_commits": true,
    "edit_format": "whole",
    "timeout": 1200
  },
  "backend_execution": {
    "mode": "exclusive",
    "fallback": "disabled",
    "gpu_lease_timeout": 120,
    "routes": {
      "spec_draft": "reasoning_ollama",
      "task_decomposition": "reasoning_ollama",
      "task_prioritization": "reasoning_ollama",
      "code_edit": "coding_ollama",
      "aider_edit": "coding_ollama",
      "code_review": "reasoning_ollama"
    },
    "profiles": {
      "reasoning_economy": {
        "backend": "llama_server",
        "model": "gemma-4-12B-it-qat-UD-Q4_K_XL",
        "openai_endpoint": "http://localhost:8080/v1",
        "port": 8080,
        "model_path": "./models/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
      },
      "reasoning_ollama": {
        "backend": "ollama",
        "model": "gemma4-12b-it-Q4_K_M:latest",
        "openai_endpoint": "http://localhost:11434/v1",
        "ollama_management_endpoint": "http://localhost:11434"
      },
      "coding_ollama": {
        "backend": "ollama",
        "model": "gemma-4-py_coder:latest",
        "openai_endpoint": "http://localhost:11434/v1",
        "ollama_management_endpoint": "http://localhost:11434"
      }
    }
  }
}
